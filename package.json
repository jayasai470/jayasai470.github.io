{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio and resume site for Jaya Sai Krishna Muppalla, built with Vite + React and a single YAML source of truth for site content and the generated PDF resume.",
  "author": "Jaya Sai Krishna Muppalla",
  "homepage": "https://jayasai470.github.io",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "handlebars": "^4.7.10",
    "motion": "^14.10.1",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build:content": "node scripts/build-content.mjs",
    "dev": "yarn build:content && vite",
    "start": "yarn dev",
    "build:file": "yarn build:content && node scripts/build-resume.cjs",
    "build": "yarn build:content && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "predeploy": "yarn build",
    "deploy": "gh-pages -b master -d dist"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "gh-pages": "^6.3.0",
    "jsdom": "27",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
