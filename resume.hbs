<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{main.name}} — Resume</title>
    <link rel="stylesheet" type="text/css" href="./css/resume.css">
</head>

<body>
    <div class="resume">
        <header class="resume-header">
            <h1>{{main.name}}</h1>
            <p class="resume-title">{{main.occupation}}</p>
            <p class="resume-contact">
                <span>{{main.address.city}}, {{main.address.state}}</span>
                <span><a href="tel:+1{{main.phone}}">{{main.phone}}</a></span>
                <span><a href="mailto:{{main.email}}">{{main.email}}</a></span>
                <span><a href="{{main.website}}">{{main.websiteDisplay}}</a></span>
                {{#if main.linkedinUrl}}<span><a href="{{main.linkedinUrl}}">{{main.linkedinDisplay}}</a></span>{{/if}}
                {{#if main.githubUrl}}<span><a href="{{main.githubUrl}}">{{main.githubDisplay}}</a></span>{{/if}}
            </p>
        </header>

        <section class="resume-section">
            <h2>Summary</h2>
            <p>{{resume.summary}}</p>
        </section>

        <section class="resume-section">
            <h2>Skills</h2>
            <ul class="resume-skills">
                {{#each resume.skillCategories}}
                    <li><strong>{{category}}:</strong> {{join items}}</li>
                {{/each}}
            </ul>
        </section>

        <section class="resume-section">
            <h2>Professional Experience</h2>
            {{#each companyGroups}}
                <article class="resume-company">
                    <div class="resume-entry-heading">
                        <h3>{{company}}</h3>
                        <span class="resume-dates">{{years}}</span>
                    </div>
                    {{#each roles}}
                        <div class="resume-role">
                            {{#if ../multiRole}}
                                <div class="resume-role-heading">
                                    <h4>{{title}}</h4>
                                    <span class="resume-dates resume-dates--role">{{years}}</span>
                                </div>
                            {{else}}
                                <h4 class="resume-role-heading resume-role-heading--single">{{title}}</h4>
                            {{/if}}
                            <ul>
                                {{#each highlights}}
                                    <li>{{this}}</li>
                                {{/each}}
                            </ul>
                        </div>
                    {{/each}}
                </article>
            {{/each}}
        </section>

        <section class="resume-section">
            <h2>Education</h2>
            {{#each resume.education}}
                <article class="resume-entry resume-entry--compact">
                    <div class="resume-entry-heading">
                        <h3>{{degree}}, {{school}}</h3>
                        <span class="resume-dates">{{dateFrom}} &ndash; {{dateTo}}</span>
                    </div>
                </article>
            {{/each}}
        </section>
    </div>
</body>

</html>
